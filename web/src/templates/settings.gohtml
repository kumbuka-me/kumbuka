{{ define "content" }}
  {{ $locale := .Locale }}
  <section class="settings-page">
    <div class="settings-heading">
      <p class="eyebrow">{{ $locale.Text "settings.account" }}</p>
      <h1>{{ $locale.Text "settings.title" }}</h1>
      <p class="muted">{{ $locale.Text "settings.intro" }}</p>
    </div>
    <div class="settings-grid">
      <section class="panel settings-panel" id="user">
        <div class="panel-title">
          <h2>{{ $locale.Text "settings.user.title" }}</h2>
        </div>
        <dl class="user-details">
          <div>
            <dt>{{ $locale.Text "settings.user.display_name" }}</dt>
            <dd>
              {{ .User.DisplayName }}
            </dd>
          </div>
          <div>
            <dt>{{ $locale.Text "settings.user.username" }}</dt>
            <dd>
              {{ .User.Username }}
            </dd>
          </div>
          <div>
            <dt>{{ $locale.Text "settings.user.email" }}</dt>
            <dd>
              {{ if .User.Email }}{{ .User.Email }}{{ else }}<span class="muted">{{ $locale.Text "settings.user.not_provided" }}</span>{{ end }}
            </dd>
          </div>
          <div>
            <dt>{{ $locale.Text "settings.user.role" }}</dt>
            <dd>
              <span class="role-badge">{{ $locale.Text (printf "role.%s" .User.Role) }}</span>
            </dd>
          </div>
          <div>
            <dt>{{ $locale.Text "settings.user.groups" }}</dt>
            <dd>
              {{ if .Groups }}
                <span class="settings-group-list">{{ range .Groups }}<span class="page-group-badge">{{ .Name }}</span>{{ end }}</span>
              {{ else }}
                <span class="muted">{{ $locale.Text "settings.user.none" }}</span>
              {{ end }}
            </dd>
          </div>
        </dl>
        <p class="settings-note">{{ $locale.Text "settings.user.identity_note" }}</p>
        {{ if eq .User.Role "admin" }}
          <p><a class="button"
   href="{{ route "/admin" }}">{{ $locale.Text "settings.user.open_administration" }}</a></p>
        {{ end }}
      </section>
      {{ if .LocalCredentialAuthenticated }}
        <section class="panel settings-panel" id="password">
          <div class="panel-title">
            <h2>{{ $locale.Text "settings.password.title" }}</h2>
          </div>
          <form class="stacked-form"
                action="{{ route "/settings/local-password" }}"
                method="post"
                data-validate-form
                novalidate>
            <label>
              {{ $locale.Text "settings.password.current" }}
              <input type="password"
                     name="current_password"
                     autocomplete="current-password"
                     data-error-required="{{ $locale.Text "settings.password.current_required" }}"
                     required />
            </label>
            <label>
              {{ $locale.Text "settings.password.new" }}
              <input type="password"
                     name="new_password"
                     autocomplete="new-password"
                     minlength="12"
                     data-validate-password
                     data-error-required="{{ $locale.Text "settings.password.new_required" }}"
                     data-error-minlength="{{ $locale.Text "settings.password.minimum" }}"
                     required />
              <small>{{ $locale.Text "settings.password.minimum_hint" }}</small>
            </label>
            <label>
              {{ $locale.Text "settings.password.confirm" }}
              <input type="password"
                     name="new_password_confirm"
                     autocomplete="new-password"
                     data-validate-match="new_password"
                     data-error-required="{{ $locale.Text "settings.password.confirm_required" }}"
                     data-error-match="{{ $locale.Text "settings.password.mismatch" }}"
                     required />
            </label>
            <div class="settings-actions">
              <button class="button primary" type="submit">{{ $locale.Text "settings.password.submit" }}</button>
            </div>
          </form>
          <p class="settings-note">{{ $locale.Text "settings.password.note" }}</p>
        </section>
      {{ end }}
      <section class="panel settings-panel" id="preferences">
        <div class="panel-title">
          <h2>{{ $locale.Text "settings.preferences.title" }}</h2>
        </div>
        <form class="preferences-form"
              action="{{ route "/settings/preferences" }}"
              method="post">
          <label>
            {{ $locale.Text "settings.preferences.language" }}
            <select name="locale">
              <option value=""
                      {{ if eq .Preferences.Locale "" }}selected{{ end }}>{{ $locale.Text "settings.preferences.language_browser" }}</option>
              {{ range .LocaleOptions }}
                <option value="{{ .Code }}"
                        {{ if eq $.Preferences.Locale .Code }}selected{{ end }}>{{ .Label }}</option>
              {{ end }}
            </select>
            <small>{{ $locale.Text "settings.preferences.language_hint" }}</small>
          </label>
          <label>
            {{ $locale.Text "settings.preferences.theme" }}
            <select name="theme" data-theme-select>
              {{ range .Themes }}
                <option value="{{ .Title }}"
                        {{ if eq $.ActiveTheme .Title }}selected{{ end }}>{{ .Title }}</option>
              {{ end }}
            </select>
            <small>{{ $locale.Text "settings.preferences.theme_hint" }}</small>
          </label>
          <label>
            {{ $locale.Text "settings.preferences.typography" }}
            <select name="typography_size"
                    data-typography-size-setting
                    data-default-typography-size="{{ .ApplicationSettings.Rendering.DefaultTypographySize }}">
              <option value=""
                      {{ if eq .Preferences.TypographySize "" }}selected{{ end }}>{{ $locale.Text "settings.preferences.application_default" }}</option>
              <option value="compact"
                      {{ if eq .Preferences.TypographySize "compact" }}selected{{ end }}>{{ $locale.Text "settings.preferences.compact" }}</option>
              <option value="standard"
                      {{ if eq .Preferences.TypographySize "standard" }}selected{{ end }}>{{ $locale.Text "settings.preferences.standard" }}</option>
              <option value="large"
                      {{ if eq .Preferences.TypographySize "large" }}selected{{ end }}>{{ $locale.Text "settings.preferences.large" }}</option>
            </select>
            <small>{{ $locale.Text "settings.preferences.typography_hint" }} {{ $locale.Label "settings.preferences" (printf "%s" .ApplicationSettings.Rendering.DefaultTypographySize) }}.</small>
          </label>
          <label class="toggle-row">
            <span>
              <strong>{{ $locale.Text "settings.preferences.show_contents" }}</strong>
              <small>{{ $locale.Text "settings.preferences.show_contents_hint" }}</small>
            </span>
            <input type="checkbox"
                   name="show_page_contents"
                   {{ if .Preferences.ShowPageContents }}checked{{ end }} />
          </label>
          <fieldset class="preference-group">
            <legend>{{ $locale.Text "settings.preferences.navigation" }}</legend>
            <fieldset class="navigation-style-setting">
              <legend>{{ $locale.Text "settings.preferences.style" }}</legend>
              <div class="navigation-style-options">
                <label class="navigation-style-option">
                  <input type="radio"
                         name="navigation_style"
                         value="sidebar"
                         {{ if eq .Preferences.NavigationStyle "sidebar" }}checked{{ end }} />
                  <span class="navigation-style-preview navigation-style-preview-sidebar"
                        aria-hidden="true"><i></i><b></b></span>
                  <span><strong>{{ $locale.Text "settings.preferences.sidebar" }}</strong><small>{{ $locale.Text "settings.preferences.sidebar_hint" }}</small></span>
                </label>
                <label class="navigation-style-option">
                  <input type="radio"
                         name="navigation_style"
                         value="topbar"
                         {{ if eq .Preferences.NavigationStyle "topbar" }}checked{{ end }} />
                  <span class="navigation-style-preview navigation-style-preview-topbar"
                        aria-hidden="true"><i></i><b></b></span>
                  <span><strong>{{ $locale.Text "settings.preferences.topbar" }}</strong><small>{{ $locale.Text "settings.preferences.topbar_hint" }}</small></span>
                </label>
                <label class="navigation-style-option">
                  <input type="radio"
                         name="navigation_style"
                         value="tree"
                         {{ if eq .Preferences.NavigationStyle "tree" }}checked{{ end }} />
                  <span class="navigation-style-preview navigation-style-preview-tree"
                        aria-hidden="true"><i></i><b></b></span>
                  <span><strong>{{ $locale.Text "settings.preferences.tree" }}</strong><small>{{ $locale.Text "settings.preferences.tree_hint" }}</small></span>
                </label>
              </div>
            </fieldset>
            <small>{{ $locale.Text "settings.preferences.preview_hint" }}</small>
            <label>
              {{ $locale.Text "settings.preferences.density" }}
              <select name="navigation_density">
                <option value="comfortable"
                        {{ if eq .Preferences.NavigationDensity "comfortable" }}selected{{ end }}>{{ $locale.Text "settings.preferences.comfortable" }}</option>
                <option value="compact"
                        {{ if eq .Preferences.NavigationDensity "compact" }}selected{{ end }}>{{ $locale.Text "settings.preferences.compact" }}</option>
              </select>
              <small>{{ $locale.Text "settings.preferences.density_hint" }}</small>
            </label>
            <fieldset class="sidebar-width-setting">
              <legend>{{ $locale.Text "settings.preferences.sidebar_width" }}</legend>
              <input type="hidden"
                     name="sidebar_width"
                     value="{{ .Preferences.SidebarWidth }}"
                     data-sidebar-width-setting />
              <div class="sidebar-width-presets"
                   role="group"
                   aria-label="{{ $locale.Text "settings.preferences.sidebar_width_presets" }}">
                <button type="button"
                        class="sidebar-width-preset"
                        data-sidebar-width-preset="240"
                        aria-pressed="false">
                  <span class="sidebar-width-preset-preview" aria-hidden="true"></span>
                  <span class="sidebar-width-preset-name">{{ $locale.Text "settings.preferences.narrow" }}</span>
                  <span class="sidebar-width-preset-value">240 px</span>
                </button>
                <button type="button"
                        class="sidebar-width-preset"
                        data-sidebar-width-preset="280"
                        aria-pressed="false">
                  <span class="sidebar-width-preset-preview" aria-hidden="true"></span>
                  <span class="sidebar-width-preset-name">{{ $locale.Text "settings.preferences.standard" }}</span>
                  <span class="sidebar-width-preset-value">280 px</span>
                </button>
                <button type="button"
                        class="sidebar-width-preset"
                        data-sidebar-width-preset="360"
                        aria-pressed="false">
                  <span class="sidebar-width-preset-preview" aria-hidden="true"></span>
                  <span class="sidebar-width-preset-name">{{ $locale.Text "settings.preferences.wide" }}</span>
                  <span class="sidebar-width-preset-value">360 px</span>
                </button>
              </div>
              <output class="sidebar-width-current"
                      data-sidebar-width-output>{{ $locale.Text "settings.preferences.current" }} · {{ .Preferences.SidebarWidth }} px</output>
              <small>{{ $locale.Text "settings.preferences.sidebar_width_hint" }}</small>
            </fieldset>
            <label class="toggle-row">
              <span><strong>{{ $locale.Text "settings.preferences.guides" }}</strong><small>{{ $locale.Text "settings.preferences.guides_hint" }}</small></span>
              <input type="checkbox"
                     name="show_navigation_guides"
                     {{ if .Preferences.ShowNavigationGuides }}checked{{ end }} />
            </label>
            <label class="toggle-row">
              <span><strong>{{ $locale.Text "settings.preferences.remember" }}</strong><small>{{ $locale.Text "settings.preferences.remember_hint" }}</small></span>
              <input type="checkbox"
                     name="remember_navigation_state"
                     {{ if .Preferences.RememberNavigationState }}checked{{ end }} />
            </label>
            <label class="toggle-row">
              <span><strong>{{ $locale.Text "settings.preferences.page_counts" }}</strong><small>{{ $locale.Text "settings.preferences.page_counts_hint" }}</small></span>
              <input type="checkbox"
                     name="show_navigation_page_counts"
                     {{ if .Preferences.ShowNavigationPageCounts }}checked{{ end }} />
            </label>
          </fieldset>
          {{ if .PluginWidgetPreferences }}
            <fieldset class="preference-group">
              <legend>{{ $locale.Text "settings.preferences.plugin_widgets" }}</legend>
              <small>{{ $locale.Text "settings.preferences.plugin_widgets_hint" }}</small>
              {{ range .PluginWidgetPreferences }}
                <input type="hidden" name="plugin_widget" value="{{ .Key }}" />
                <label class="toggle-row">
                  <span><strong>{{ .Label }}</strong><small>{{ $locale.SurfaceLabel .Surface }}{{ if .Description }} · {{ .Description }}{{ end }}</small></span>
                  <input type="checkbox"
                         name="visible_plugin_widget"
                         value="{{ .Key }}"
                         {{ if .Visible }}checked{{ end }} />
                </label>
              {{ end }}
            </fieldset>
          {{ end }}
          <div class="settings-actions">
            <button class="button primary" type="submit">{{ $locale.Text "settings.preferences.save" }}</button>
          </div>
        </form>
      </section>
      <section class="panel settings-panel settings-wide" id="saved-searches">
        <div class="panel-title">
          <div>
            <h2>{{ $locale.Text "settings.saved_searches.title" }}</h2>
            <p class="muted">{{ $locale.Text "settings.saved_searches.intro" }}</p>
          </div>
        </div>
        <form class="saved-search-create"
              action="{{ route "/settings/saved-searches" }}"
              method="post">
          <label>
            {{ $locale.Text "settings.saved_searches.name" }}<input name="name"
       required
       placeholder="{{ $locale.Text "settings.saved_searches.name_placeholder" }}" />
          </label>
          <label>
            {{ $locale.Text "settings.saved_searches.query" }}<input name="query"
       required
       placeholder="{{ $locale.Text "settings.saved_searches.query_placeholder" }}" />
          </label>
          <label class="toggle-row compact">
            <span><strong>{{ $locale.Text "settings.saved_searches.pin" }}</strong></span><input type="checkbox"
       name="pinned"
       checked />
          </label>
          <button class="button primary" type="submit">{{ icon "bookmark-plus-lucide" 15 }}<span>{{ $locale.Text "settings.saved_searches.save" }}</span></button>
        </form>
        <div class="saved-search-list">
          {{ range .SavedSearches }}
            <article>
              <a href="{{ route "/search?q=" }}{{ .Query }}"><span>{{ icon "search-lucide" 15 }}</span><span><strong>{{ .Name }}</strong><small>{{ .Query }}</small></span></a>
              <form action="{{ route "/settings/saved-searches/" }}{{ .ID }}/delete"
                    method="post">
                <button class="icon-button"
                        type="submit"
                        data-confirm="{{ $locale.Textf "settings.saved_searches.delete_confirm" .Name }}"
                        aria-label="{{ $locale.Text "settings.saved_searches.delete_label" }}">{{ icon "trash-2-lucide" 15 }}</button>
              </form>
            </article>
          {{ else }}
            <p class="muted">{{ $locale.Text "settings.saved_searches.empty" }}</p>
          {{ end }}
        </div>
      </section>
      <section class="panel settings-panel settings-wide" id="tokens">
        <div class="panel-title">
          <h2>{{ $locale.Text "settings.tokens.title" }}</h2>
        </div>
        <p class="settings-note">
          {{ $locale.Text "settings.tokens.intro_before" }} <code>Authorization: Bearer TOKEN</code> {{ $locale.Text "settings.tokens.intro_after" }}
        </p>
        <form class="token-create-form"
              data-token-form
              action="{{ route "/settings/tokens" }}"
              method="post">
          <label>
            {{ $locale.Text "settings.tokens.name" }}<input name="name"
       required
       maxlength="120"
       placeholder="{{ $locale.Text "settings.tokens.name_placeholder" }}" />
          </label>
          <label>
            {{ $locale.Text "settings.tokens.expires" }} <span class="optional">{{ $locale.Text "settings.tokens.optional" }}</span><input type="date" name="expires" />
          </label>
          <button class="button primary" type="submit">{{ $locale.Text "settings.tokens.create" }}</button>
        </form>
        <div class="token-secret" data-token-secret hidden></div>
        <div class="admin-table-wrap">
          <table class="admin-table token-table">
            <thead>
              <tr>
                <th>{{ $locale.Text "settings.tokens.name" }}</th>
                <th>{{ $locale.Text "settings.tokens.created" }}</th>
                <th>{{ $locale.Text "settings.tokens.last_used" }}</th>
                <th>{{ $locale.Text "settings.tokens.expires" }}</th>
                <th></th>
              </tr>
            </thead>
            <tbody data-token-list>
              {{ range .UserTokens }}
                <tr data-token-row>
                  <td><strong>{{ .Name }}</strong></td>
                  <td>{{ $locale.TimeAgo .CreatedAt }}</td>
                  <td>
                    {{ if .LastUsed }}
                      {{ .LastUsed.Format "2006-01-02 15:04" }}
                    {{ else }}
                      <span class="muted">{{ $locale.Text "settings.tokens.never" }}</span>
                    {{ end }}
                  </td>
                  <td>{{ if .ExpiresAt }}{{ .ExpiresAt.Format "2006-01-02" }}{{ else }}{{ $locale.Text "settings.tokens.never" }}{{ end }}</td>
                  <td>
                    <button class="button danger"
                            type="button"
                            data-token-delete
                            data-delete-url="{{ route "/settings/tokens/" }}{{ .ID }}">{{ $locale.Text "settings.tokens.revoke" }}</button>
                  </td>
                </tr>
              {{ else }}
                <tr data-token-empty>
                  <td colspan="5" class="muted">{{ $locale.Text "settings.tokens.empty" }}</td>
                </tr>
              {{ end }}
            </tbody>
          </table>
        </div>
      </section>
      {{ if .CanEdit }}
        <section class="panel settings-panel settings-wide"
                 id="media"
                 data-media-settings-browser
                 data-media-list-url="{{ route "/api/images" }}"
                 data-media-scope="mine"
                 data-media-mode="user"
                 data-media-page-size="30"
                 data-media-offset="{{ len .Images }}">
          <div class="panel-title">
            <h2>{{ $locale.Text "settings.images.title" }}</h2>
            <span class="muted" data-media-settings-count>{{ len .Images }} {{ $locale.Text "settings.images.shown" }}{{ if .ImagesHasMore }} · {{ $locale.Text "settings.images.more_available" }}{{ end }}</span>
          </div>
          <p class="settings-note">{{ $locale.Text "settings.images.intro" }}</p>
          <form class="media-settings-search"
                method="get"
                action="{{ route "/settings#media" }}"
                data-media-settings-search>
            <input type="search"
                   name="image_q"
                   value="{{ .ImageQuery }}"
                   maxlength="200"
                   placeholder="{{ $locale.Text "settings.images.search_placeholder" }}"
                   aria-label="{{ $locale.Text "settings.images.search_label" }}"
                   data-media-settings-search-input />
            <button class="button"
                    type="submit">{{ icon "search-lucide" 16 }}<span>{{ $locale.Text "settings.images.search" }}</span></button>
            <a class="button"
               href="{{ route "/settings#media" }}"
               data-media-settings-clear
               {{ if not .ImageQuery }}hidden{{ end }}>{{ $locale.Text "settings.images.clear" }}</a>
          </form>
          <div class="media-settings-list" data-media-settings-list>
            {{ range .Images }}
              <article class="media-settings-row"
                       data-media-settings-item
                       data-media-id="{{ .ID }}">
                <img src="{{ route .URL }}" alt="" loading="lazy" />
                <div class="media-settings-info">
                  <strong>{{ .Filename }}</strong>
                  <small>{{ filesize .SizeBytes }} · {{ $locale.TimeAgo .CreatedAt }}</small>
                  {{ if gt .UsageCount 0 }}
                    <small class="media-used">{{ $locale.Text "settings.images.referenced" }} {{ .UsageCount }} {{ if eq .UsageCount 1 }}{{ $locale.Text "settings.images.time" }}{{ else }}{{ $locale.Text "settings.images.times" }}{{ end }}</small>
                  {{ else }}
                    <small class="media-unused">{{ $locale.Text "settings.images.unused" }}</small>
                  {{ end }}
                  <code>{{ .URL }}</code>
                </div>
                <div class="media-settings-actions">
                  {{ if eq .UsageCount 0 }}
                    <button class="button danger"
                            type="button"
                            data-media-delete
                            data-media-usage="0"
                            data-delete-url="{{ route "/api/images/" }}{{ .ID }}">{{ $locale.Text "settings.images.delete" }}</button>
                  {{ end }}
                </div>
              </article>
            {{ else }}
              <p class="muted" data-media-settings-empty>
                {{ if .ImageQuery }}{{ $locale.Text "settings.images.no_match" }}{{ else }}{{ $locale.Text "settings.images.empty" }}{{ end }}
              </p>
            {{ end }}
          </div>
          <div class="media-settings-pagination">
            <button class="button"
                    type="button"
                    data-media-load-more
                    {{ if not .ImagesHasMore }}hidden{{ end }}>{{ $locale.Text "settings.images.load_more" }}</button>
            <span class="muted" data-media-load-status></span>
          </div>
        </section>
      {{ end }}
    </div>
  </section>
{{ end }}
