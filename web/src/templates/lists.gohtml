{{ define "page-row" }}
  <a class="page-row" href="/pages/{{ .Slug }}">
    <span class="doc-icon">{{ if .Icon }}{{ icon .Icon 17 }}{{ else }}{{ icon "file-text-lucide" 17 }}{{ end }}</span>
    <span>
      <strong>{{ .Title }}</strong>
      <small>{{ .Slug }}{{ if .Tags }}· {{ join .Tags ", " }}{{ end }}</small>
    </span>
    <time>{{ timeago .UpdatedAt }}</time>
  </a>
{{ end }}
{{ define "compact-row" }}
  <a class="compact-row" href="/pages/{{ .Slug }}">
    <span>{{ if .Icon }}{{ icon .Icon 15 }}{{ else }}{{ icon "file-text-lucide" 15 }}{{ end }}</span>
    <strong>{{ .Title }}</strong>
    <small>{{ .ViewCount }} views</small>
  </a>
{{ end }}
