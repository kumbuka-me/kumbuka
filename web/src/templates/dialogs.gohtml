{{ define "app-dialogs" }}
  <dialog class="app-dialog"
          data-confirm-dialog
          aria-labelledby="confirm-dialog-title">
    <div class="app-dialog-header">
      <div>
        <p class="eyebrow" data-confirm-dialog-eyebrow>Confirmation</p>
        <h2 id="confirm-dialog-title" data-confirm-dialog-title>Confirm action</h2>
      </div>
      <button class="icon-button app-dialog-close"
              type="button"
              data-confirm-dialog-cancel
              aria-label="Close">{{ icon "x-lucide" 20 }}</button>
    </div>
    <div class="app-dialog-body">
      <p data-confirm-dialog-message></p>
    </div>
    <div class="app-dialog-actions">
      <button class="button"
              type="button"
              data-confirm-dialog-cancel
              data-confirm-dialog-cancel-label>Cancel</button>
      <button class="button danger" type="button" data-confirm-dialog-accept>Continue</button>
    </div>
  </dialog>
  <dialog class="app-dialog problem-dialog"
          data-problem-dialog
          aria-labelledby="problem-dialog-title">
    <div class="app-dialog-header">
      <div>
        <p class="eyebrow problem-dialog-eyebrow">{{ icon "triangle-alert-lucide" 14 }} Error</p>
        <h2 id="problem-dialog-title" data-problem-dialog-title>Something went wrong</h2>
      </div>
      <button class="icon-button app-dialog-close"
              type="button"
              data-problem-dialog-close
              aria-label="Close">{{ icon "x-lucide" 20 }}</button>
    </div>
    <div class="app-dialog-body problem-dialog-body">
      <p data-problem-dialog-message></p>
      <dl class="problem-dialog-details" data-problem-dialog-details hidden>
      </dl>
    </div>
    <div class="app-dialog-actions">
      <button class="button primary" type="button" data-problem-dialog-close>Close</button>
    </div>
  </dialog>
  <dialog class="app-dialog"
          data-notice-dialog
          aria-labelledby="notice-dialog-title">
    <div class="app-dialog-header">
      <div>
        <p class="eyebrow">Kumbuka</p>
        <h2 id="notice-dialog-title" data-notice-dialog-title>Notice</h2>
      </div>
      <button class="icon-button app-dialog-close"
              type="button"
              data-notice-dialog-close
              aria-label="Close">{{ icon "x-lucide" 20 }}</button>
    </div>
    <div class="app-dialog-body">
      <p data-notice-dialog-message></p>
    </div>
    <div class="app-dialog-actions">
      <button class="button primary" type="button" data-notice-dialog-close>OK</button>
    </div>
  </dialog>
  <dialog class="app-dialog about-dialog"
          data-about-dialog
          aria-labelledby="about-dialog-title">
    <div class="app-dialog-header">
      <div>
        <p class="eyebrow">Kumbuka</p>
        <h2 id="about-dialog-title">About Kumbuka</h2>
      </div>
      <button class="icon-button app-dialog-close"
              type="button"
              data-about-close
              aria-label="Close">{{ icon "x-lucide" 20 }}</button>
    </div>
    <div class="app-dialog-body about-dialog-body">
      <p>A self-hosted, Markdown-first knowledge base.</p>
      <dl class="about-dialog-details">
        <div>
          <dt>Version</dt>
          <dd>{{ .Version }}</dd>
        </div>
        <div>
          <dt>Commit</dt>
          <dd><code>{{ .Commit }}</code></dd>
        </div>
      </dl>
      <nav class="about-dialog-links" aria-label="Kumbuka project links">
        <a href="https://kumbuka.me/" target="_blank" rel="noopener noreferrer">Documentation</a>
        <a href="https://github.com/kumbuka-me/kumbuka"
           target="_blank"
           rel="noopener noreferrer">GitHub</a>
        <a href="https://github.com/kumbuka-me/kumbuka/blob/main/LICENSE"
           target="_blank"
           rel="noopener noreferrer">Apache-2.0</a>
      </nav>
    </div>
    <div class="app-dialog-actions">
      <button class="button primary" type="button" data-about-close>Close</button>
    </div>
  </dialog>
  <dialog class="app-dialog command-palette"
          data-command-palette
          aria-labelledby="command-palette-title">
    <div class="command-palette-search">
      {{ icon "search-lucide" 18 }}
      <input type="search"
             data-command-palette-input
             placeholder="Search pages or commands…"
             autocomplete="off"
             aria-label="Search pages or commands" />
      <kbd>Esc</kbd>
    </div>
    <h2 class="sr-only" id="command-palette-title">Command palette</h2>
    <div class="command-palette-options" role="listbox">
      <div class="command-palette-static">
        <a href="/"
           class="command-palette-option"
           data-command-option
           data-command-static
           role="option">{{ icon "house-lucide" 17 }}<span><strong>Home</strong><small>Open dashboard</small></span></a>
        {{ if .CanEdit }}
          <a href="/pages/new{{ if .NewPageParent }}?parent={{ .NewPageParent | urlquery }}{{ end }}"
             class="command-palette-option"
             data-command-option
             data-command-static
             role="option">{{ icon "plus-lucide" 17 }}<span><strong>New page</strong><small>Create a page</small></span></a>
        {{ end }}
        {{ if .CurrentPage }}
          {{ if .CanEdit }}
            <a href="/edit/{{ .CurrentPage.Slug }}"
               class="command-palette-option"
               data-command-option
               data-command-static
               role="option">{{ icon "pencil-lucide" 17 }}<span><strong>Edit current page</strong><small>{{ .CurrentPage.Title }}</small></span></a>
          {{ end }}
        {{ end }}
        <a href="/graph{{ if .CurrentPage }}?slug={{ .CurrentPage.Slug }}{{ end }}"
           class="command-palette-option"
           data-command-option
           data-command-static
           role="option">{{ icon "network-lucide" 17 }}<span><strong>Knowledge graph</strong><small>Explore page relationships</small></span></a>
        <button type="button"
                class="command-palette-option"
                data-command-option
                data-command-static
                data-shortcuts-open
                role="option">
          {{ icon "keyboard-lucide" 17 }}<span><strong>Keyboard shortcuts</strong><small>Show navigation and editor shortcuts</small></span>
        </button>
        <a href="/settings"
           class="command-palette-option"
           data-command-option
           data-command-static
           role="option">{{ icon "settings-lucide" 17 }}<span><strong>Settings</strong><small>Personal preferences</small></span></a>
        {{ if eq .User.Role "admin" }}
          <a href="/admin"
             class="command-palette-option"
             data-command-option
             data-command-static
             role="option">{{ icon "shield-lucide" 17 }}<span><strong>Administration</strong><small>Manage Kumbuka</small></span></a>
        {{ end }}
      </div>
      <div data-command-palette-results></div>
    </div>
    <button class="sr-only" type="button" data-command-palette-close>Close command palette</button>
  </dialog>
  <dialog class="app-dialog shortcuts-dialog"
          data-shortcuts-dialog
          aria-labelledby="shortcuts-dialog-title">
    <div class="app-dialog-header">
      <div>
        <p class="eyebrow">Keyboard</p>
        <h2 id="shortcuts-dialog-title">Keyboard shortcuts</h2>
      </div>
      <button class="icon-button app-dialog-close"
              type="button"
              data-shortcuts-close
              aria-label="Close">{{ icon "x-lucide" 20 }}</button>
    </div>
    <div class="app-dialog-body shortcut-grid">
      <div><kbd>⌘/Ctrl K</kbd><span>Command palette</span></div>
      <div><kbd>/</kbd><span>Focus global search</span></div>
      <div><kbd>G H</kbd><span>Go home</span></div>
      <div><kbd>G G</kbd><span>Knowledge graph</span></div>
      <div><kbd>C</kbd><span>Create page</span></div>
      <div><kbd>E</kbd><span>Edit current page</span></div>
      <div><kbd>?</kbd><span>Show this dialog</span></div>
      <div><kbd>Esc</kbd><span>Close dialogs / focus mode</span></div>
    </div>
  </dialog>
{{ end }}
