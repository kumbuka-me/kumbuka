{{ define "webhook-fields" }}
  <div class="webhook-fields" data-webhook-form-fields>
    <div class="webhook-field-grid">
      <label>
        <span>Name</span>
        <input name="name"
               required
               value="{{ .Name }}"
               placeholder="Documentation automation" />
      </label>
      <label class="webhook-endpoint-field">
        <span>Endpoint</span>
        <input name="url"
               type="url"
               required
               value="{{ .URL }}"
               placeholder="https://hooks.slack.com/services/..." />
      </label>
    </div>
    <label class="webhook-enabled-row">
      <span>
        <strong>Enabled</strong>
        <small>Deliver matching Kumbuka events to this endpoint.</small>
      </span>
      <input type="checkbox" name="enabled" {{ if .Enabled }}checked{{ end }} />
    </label>
    <section class="webhook-payload-settings">
      <div class="webhook-section-heading">
        <div>
          <strong>JSON payload</strong>
          <small>Transform Kumbuka events into the JSON body expected by the receiver.</small>
        </div>
        <div class="webhook-template-heading-actions">
          <span class="webhook-template-badge">Go template</span>
          <button class="button compact"
                  type="button"
                  data-webhook-help-open>{{ icon "info-lucide" 14 }}<span>Fields</span></button>
        </div>
      </div>
      <label class="webhook-template-field">
        <textarea name="body_template"
                  rows="13"
                  spellcheck="false"
                  autocapitalize="off"
                  autocomplete="off"
                  data-webhook-template>{{ .BodyTemplate }}</textarea>
      </label>
      <p class="webhook-template-help">
        Use <code>{{ "{{ .Input.Event | json }}" }}</code> for the event name and
        <code>.Payload.ActorID</code>, <code>.Payload.ObjectType</code>, <code>.Payload.ObjectKey</code>,
        <code>.Payload.Detail</code>, <code>.Payload.Data</code>, <code>.Payload.OccurredAt</code>, or <code>.Payload.URL</code> for event data.
        Type <code>.Input</code> or <code>.Payload</code> for suggestions.
      </p>
      <label class="webhook-enabled-row webhook-user-details">
        <span>
          <strong>Include user details</strong>
          <small>Allow this template to use actor and recipient contact fields, including email.</small>
        </span>
        <input type="checkbox"
               name="include_user_details"
               {{ if .IncludeUserDetails }}checked{{ end }} />
      </label>
    </section>
    <section class="webhook-header-settings">
      <div class="webhook-section-heading">
        <div>
          <strong>Request headers</strong>
          <small>Add authentication or receiver-specific HTTP headers. Kumbuka manages transport headers such as Content-Type.</small>
        </div>
        <button class="button compact"
                type="button"
                data-webhook-header-add
                title="Add request header">{{ icon "plus-lucide" 14 }}<span>Add</span></button>
      </div>
      {{ if not .EncryptionKeyConfigured }}
        <p class="webhook-header-note warning">Configure <code>KUMBUKA__ENCRYPTION_KEY</code> before storing sensitive header values.</p>
      {{ else }}
        <p class="webhook-header-note">Mark secrets with the key icon. Sensitive values are encrypted at rest.</p>
      {{ end }}
      <div class="webhook-header-list" data-webhook-header-list>
        {{ range .Headers }}
          <div class="webhook-header-row"
               data-webhook-header-row
               data-webhook-header-existing="true">
            <input type="hidden" name="webhook_header_row" value="h{{ .ID }}" />
            <input type="hidden" name="webhook_header_h{{ .ID }}_id" value="{{ .ID }}" />
            <label class="webhook-header-name">
              <span>Name</span>
              <input type="text"
                     name="webhook_header_h{{ .ID }}_name"
                     value="{{ .Name }}"
                     autocomplete="off"
                     placeholder="Authorization"
                     data-webhook-header-name />
            </label>
            <label class="webhook-header-value">
              <span>Value</span>
              <input type="{{ if and .Sensitive .Configured }}password{{ else }}text{{ end }}"
                     name="webhook_header_h{{ .ID }}_value"
                     value="{{ .Value }}"
                     autocomplete="off"
                     placeholder="{{ if and .Sensitive .Configured }}Stored encrypted value{{ else }}Bearer token{{ end }}"
                     data-webhook-header-value />
            </label>
            <div class="webhook-header-actions">
              <label class="webhook-header-sensitive"
                     title="Sensitive: encrypt this header value at rest">
                <input type="checkbox"
                       name="webhook_header_h{{ .ID }}_sensitive"
                       data-webhook-header-sensitive
                       aria-label="Encrypt this header value at rest"
                       {{ if .Sensitive }}checked{{ end }} />
                <span class="webhook-header-sensitive-icon" aria-hidden="true">{{ icon "key-round-lucide" 14 }}</span>
              </label>
              {{ if and .Sensitive .Configured }}
                <button class="button compact"
                        type="button"
                        data-webhook-header-reveal
                        data-webhook-id="{{ $.ID }}"
                        data-webhook-header-id="{{ .ID }}"
                        {{ if not $.EncryptionKeyConfigured }}disabled{{ end }}>Reveal</button>
              {{ end }}
              <button class="icon-button"
                      type="button"
                      data-webhook-header-remove
                      aria-label="Remove webhook request header">{{ icon "trash-2-lucide" 15 }}</button>
            </div>
          </div>
        {{ end }}
      </div>
      <template data-webhook-header-template>
        <div class="webhook-header-row"
             data-webhook-header-row
             data-webhook-header-existing="false">
          <input type="hidden" data-webhook-header-row-key />
          <input type="hidden" data-webhook-header-id />
          <label class="webhook-header-name">
            <span>Name</span>
            <input type="text"
                   autocomplete="off"
                   placeholder="Authorization"
                   data-webhook-header-name />
          </label>
          <label class="webhook-header-value">
            <span>Value</span>
            <input type="text"
                   autocomplete="off"
                   placeholder="Bearer token"
                   data-webhook-header-value />
          </label>
          <div class="webhook-header-actions">
            <label class="webhook-header-sensitive"
                   title="Sensitive: encrypt this header value at rest">
              <input type="checkbox"
                     data-webhook-header-sensitive
                     aria-label="Encrypt this header value at rest" />
              <span class="webhook-header-sensitive-icon" aria-hidden="true">{{ icon "key-round-lucide" 14 }}</span>
            </label>
            <button class="icon-button"
                    type="button"
                    data-webhook-header-remove
                    aria-label="Remove webhook request header">{{ icon "trash-2-lucide" 15 }}</button>
          </div>
        </div>
      </template>
      <p class="webhook-header-status"
         data-webhook-header-status
         aria-live="polite"></p>
    </section>
    <details class="webhook-retry-settings">
      <summary class="webhook-retry-summary">
        <div>
          <strong>Retries</strong>
          <small>Use Notifykit's default transient-failure policy for timeouts, network errors, HTTP 408/429, and 5xx responses.</small>
        </div>
        <span class="webhook-retry-summary-chevron" aria-hidden="true">{{ icon "chevron-down-lucide" 14 }}</span>
      </summary>
      <div class="webhook-retry-content">
        <label class="webhook-enabled-row webhook-retry-enabled">
          <span>
            <strong>Retry transient failures</strong>
            <small>Disable this to make exactly one delivery attempt.</small>
          </span>
          <input type="checkbox"
                 name="retry_enabled"
                 data-webhook-retry-enabled
                 {{ if .RetryEnabled }}checked{{ end }} />
        </label>
        <div class="webhook-retry-fields" data-webhook-retry-fields>
          <div class="webhook-retry-grid">
            <label>
              <span>Retries</span>
              <input name="retry_count"
                     type="number"
                     min="1"
                     max="10"
                     value="{{ .RetryCount }}" />
              <small>Attempts after the initial request.</small>
            </label>
            <label>
              <span>Initial backoff</span>
              <input name="retry_backoff" value="{{ .RetryBackoff }}" placeholder="1s" />
              <small>Examples: <code>500ms</code>, <code>1s</code>.</small>
            </label>
            <label>
              <span>Maximum backoff</span>
              <input name="retry_max_backoff"
                     value="{{ .RetryMaxBackoff }}"
                     placeholder="30s" />
              <small>Upper bound for exponential backoff.</small>
            </label>
          </div>
          <label class="webhook-enabled-row webhook-retry-jitter">
            <span>
              <strong>Jitter</strong>
              <small>Randomize waits to avoid synchronized retries.</small>
            </span>
            <input type="checkbox"
                   name="retry_jitter"
                   {{ if .RetryJitter }}checked{{ end }} />
          </label>
        </div>
      </div>
    </details>
    <fieldset class="webhook-events">
      <legend>
        <span>Events</span>
        <small>Select the Kumbuka events delivered to this endpoint.</small>
      </legend>
      <div class="webhook-event-grid">
        {{ range $event := .AvailableEvents }}
          <label class="webhook-event-option">
            <input type="checkbox"
                   name="event"
                   value="{{ $event }}"
                   {{ if hasstring $.Events $event }}checked{{ end }} />
            <code>{{ $event }}</code>
          </label>
        {{ end }}
      </div>
    </fieldset>
  </div>
{{ end }}
{{ define "content" }}
  <section class="admin-page webhook-admin">
    <div class="settings-heading webhook-heading">
      <p class="eyebrow">Administration</p>
      <h1>Webhooks</h1>
      <p class="muted">Transform Kumbuka events into JSON and deliver them to chat, automation, CI, or custom APIs.</p>
    </div>
    <div class="webhook-workspace">
      <section class="panel webhook-create-panel">
        <div class="admin-card-heading">
          <span class="admin-card-icon">{{ icon "webhook-lucide" 19 }}</span>
          <div>
            <h2>New webhook</h2>
            <p class="muted">Configure an endpoint, payload, headers, retries, and matching events.</p>
          </div>
        </div>
        <form action="/admin/webhooks"
              method="post"
              class="stacked-form"
              data-webhook-form
              data-validate-form
              data-error-title="Could not save webhook">
          {{ template "webhook-fields" (webhookcontext .WebhookDraft .WebhookEvents .Runtime.EncryptionKeyConfigured) }}
          <div class="form-actions">
            <button class="button primary" type="submit">{{ icon "plus-lucide" 15 }}<span>Create webhook</span></button>
          </div>
        </form>
      </section>
      <section class="panel admin-library-panel webhook-list-panel">
        <div class="panel-title">
          <div>
            <h2>Configured webhooks</h2>
            <p class="muted">Edit, test, disable, or remove existing destinations.</p>
          </div>
          <span class="count-chip">{{ len .Webhooks }}</span>
        </div>
        <div class="admin-expand-list">
          {{ range .Webhooks }}
            <details class="admin-expand-item webhook-item">
              <summary>
                <span class="admin-expand-icon">{{ icon "webhook-lucide" 16 }}</span>
                <span>
                  <strong>{{ .Name }}</strong>
                  <small>{{ .URL }} · {{ if .Enabled }}enabled{{ else }}disabled{{ end }}</small>
                </span>
                {{ icon "chevron-down-lucide" 15 }}
              </summary>
              <div class="admin-expand-body webhook-edit-body">
                <form action="/admin/webhooks/{{ .ID }}"
                      method="post"
                      class="stacked-form"
                      data-webhook-form
                      data-validate-form
                      data-error-title="Could not save webhook">
                  {{ template "webhook-fields" (webhookcontext . $.WebhookEvents $.Runtime.EncryptionKeyConfigured) }}
                  <div class="form-actions">
                    <button class="button primary"
                            type="submit">{{ icon "save-lucide" 15 }}<span>Save changes</span></button>
                  </div>
                </form>
                <div class="webhook-secondary-actions">
                  <form action="/admin/webhooks/{{ .ID }}/test" method="post">
                    <button class="button" type="submit">{{ icon "send-lucide" 15 }}<span>Send test</span></button>
                  </form>
                  <form action="/admin/webhooks/{{ .ID }}/delete"
                        method="post"
                        data-confirm="Delete webhook {{ .Name }}?"
                        data-confirm-title="Delete webhook"
                        data-confirm-label="Delete webhook">
                    <button class="button danger"
                            type="submit">{{ icon "trash-2-lucide" 15 }}<span>Delete</span></button>
                  </form>
                </div>
              </div>
            </details>
          {{ else }}
            <div class="empty webhook-empty">
              {{ icon "webhook-lucide" 22 }}
              <strong>No webhooks yet.</strong>
              <p>Create one to send Kumbuka events to another system.</p>
            </div>
          {{ end }}
        </div>
      </section>
    </div>
    <section class="panel settings-wide webhook-deliveries-panel">
      <div class="panel-title">
        <div>
          <h2>Recent deliveries</h2>
          <p class="muted">Latest successful and failed Notifykit delivery outcomes.</p>
        </div>
        <span class="count-chip">{{ len .WebhookDeliveries }}</span>
      </div>
      {{ if .WebhookDeliveries }}
        <div class="webhook-deliveries">
          {{ range .WebhookDeliveries }}
            <div class="webhook-delivery-row">
              <span class="webhook-delivery-icon{{ if .Error }} error{{ end }}">{{ if .Error }}{{ icon "triangle-alert-lucide" 15 }}{{ else }}{{ icon "check-circle-lucide" 15 }}{{ end }}</span>
              <div>
                <strong>{{ .WebhookName }}</strong>
                <code>{{ .Event }}</code>
                <small>
                  {{ .CreatedAt.Format "2006-01-02 15:04:05" }}
                  {{ if .StatusCode }} · HTTP {{ .StatusCode }}{{ end }}
                  {{ if .Attempts }} · {{ .Attempts }} attempt{{ if ne .Attempts 1 }}s{{ end }}{{ end }}
                  {{ if .Error }} · {{ .Error }}{{ end }}
                </small>
              </div>
            </div>
          {{ end }}
        </div>
      {{ else }}
        <p class="muted webhook-no-deliveries">No deliveries yet.</p>
      {{ end }}
    </section>
    <dialog class="app-dialog webhook-help-dialog"
            data-webhook-help-dialog
            aria-labelledby="webhook-help-title">
      <div class="app-dialog-header">
        <div>
          <p class="eyebrow">Webhook reference</p>
          <h2 id="webhook-help-title">Fields and template data</h2>
        </div>
        <button class="icon-button app-dialog-close"
                type="button"
                data-webhook-help-close
                aria-label="Close webhook reference">{{ icon "x-lucide" 20 }}</button>
      </div>
      <div class="app-dialog-body webhook-help-body">
        <section>
          <h3>Configuration</h3>
          <dl class="webhook-help-definitions">
            <div>
              <dt>Name</dt>
              <dd>
                Identifies this destination in administration and delivery history.
              </dd>
            </div>
            <div>
              <dt>Endpoint</dt>
              <dd>
                The absolute HTTP or HTTPS URL that receives POST requests.
              </dd>
            </div>
            <div>
              <dt>Enabled</dt>
              <dd>
                Controls whether matching events are delivered.
              </dd>
            </div>
            <div>
              <dt>JSON payload</dt>
              <dd>
                A Go template that must render valid JSON. Pipe inserted values through <code>| json</code>.
              </dd>
            </div>
            <div>
              <dt>Include user details</dt>
              <dd>
                Resolves actor and recipient contact data for this template. Leave disabled unless the receiver needs it.
              </dd>
            </div>
            <div>
              <dt>Request headers</dt>
              <dd>
                Add receiver-specific headers. Sensitive values are encrypted and hidden after saving.
              </dd>
            </div>
            <div>
              <dt>Retries</dt>
              <dd>
                Retry count is additional attempts; backoff grows up to the maximum, and jitter randomizes delays.
              </dd>
            </div>
            <div>
              <dt>Events</dt>
              <dd>
                Select which generic Kumbuka events trigger this destination.
              </dd>
            </div>
          </dl>
        </section>
        <section>
          <h3>Template fields</h3>
          <div class="webhook-help-table-wrap">
            <table class="webhook-help-table">
              <thead>
                <tr>
                  <th>Field</th>
                  <th>Meaning</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><code>.Input.Event</code></td>
                  <td>Event name, such as <code>notification.created</code>.</td>
                </tr>
                <tr>
                  <td><code>.Payload.ActorID</code></td>
                  <td>Stable ID of the user who caused the event, or zero.</td>
                </tr>
                <tr>
                  <td><code>.Payload.ObjectType</code></td>
                  <td>Generic affected resource type.</td>
                </tr>
                <tr>
                  <td><code>.Payload.ObjectKey</code></td>
                  <td>Resource identifier within its type.</td>
                </tr>
                <tr>
                  <td><code>.Payload.Detail</code></td>
                  <td>Optional human-readable event summary.</td>
                </tr>
                <tr>
                  <td><code>.Payload.Data</code></td>
                  <td>Event-specific map. Access a key with <code>index .Payload.Data "key"</code>.</td>
                </tr>
                <tr>
                  <td><code>.Payload.OccurredAt</code></td>
                  <td>UTC timestamp for the committed mutation.</td>
                </tr>
                <tr>
                  <td><code>.Payload.URL</code></td>
                  <td>Public Kumbuka page URL when the event identifies a page.</td>
                </tr>
                <tr>
                  <td><code>.Payload.Actor.*</code></td>
                  <td><code>ID</code>, <code>Mention</code>, <code>DisplayName</code>, <code>Email</code>, and <code>Enabled</code> for the actor.</td>
                </tr>
                <tr>
                  <td><code>.Payload.Recipient.*</code></td>
                  <td>The same fields for the target user, when the event has one.</td>
                </tr>
                <tr>
                  <td><code>.Receiver</code></td>
                  <td>Configured webhook receiver name.</td>
                </tr>
                <tr>
                  <td><code>.Title</code></td>
                  <td>Rendered delivery title; currently the event name.</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="muted">Actor and recipient objects are available only when <strong>Include user details</strong> is enabled. Some events do not have one or both users.</p>
        </section>
      </div>
      <div class="app-dialog-actions">
        <button class="button" type="button" data-webhook-help-close>Close</button>
      </div>
    </dialog>
  </section>
{{ end }}
