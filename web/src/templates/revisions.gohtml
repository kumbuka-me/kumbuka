{{ define "revision-item" }}
  <div class="revision">
    <div class="revision-heading">
      <strong>{{ .Author }}</strong>
      <span class="revision-number">r{{ .Number }}</span>
    </div>
    {{ if .Message }}<span class="revision-message">{{ .Message }}</span>{{ end }}
    <small class="revision-meta">
      <span>{{ timeago .CreatedAt }}</span>
      {{ if or .AddedLines .RemovedLines }}
        <span class="revision-diff"><span class="revision-added">+{{ .AddedLines }}</span><span class="revision-removed">−{{ .RemovedLines }}</span> lines</span>
      {{ else if eq .Number 1 }}
        <span>created page</span>
      {{ else if .MetadataChanges }}
        <span>Metadata updated</span>
      {{ else }}
        <span>No Markdown changes</span>
      {{ end }}
      {{ if .MetadataChanges }}
        <span>Changed: {{ range $index, $field := .MetadataChanges }}{{ if $index }}, {{ end }}{{ $field }}{{ end }}</span>
      {{ end }}
    </small>
  </div>
{{ end }}
{{ define "revision-list" }}
  {{ $root := . }}
  <div class="revision-list" data-revision-list>
    {{ if .Revisions }}
      <div class="revision-list-toolbar">
        <button class="button revision-toggle-all"
                type="button"
                data-revision-toggle-all
                aria-expanded="false">
          {{ icon "chevrons-down-lucide" 14 }}<span>Show all changes</span>
        </button>
      </div>
    {{ end }}
    {{ range $index, $revision := .Revisions }}
      <article class="revision-entry{{ if eq $index 0 }} is-open{{ end }}"
               data-revision-entry
               data-revision-number="{{ $revision.Number }}">
        <div class="revision-entry-heading">
          <button class="revision-entry-toggle"
                  type="button"
                  data-revision-toggle
                  aria-expanded="{{ if eq $index 0 }}true{{ else }}false{{ end }}"
                  aria-controls="revision-content-{{ $revision.Number }}"
                  aria-label="{{ if eq $index 0 }}Hide{{ else }}Show{{ end }} changes for revision {{ $revision.Number }}"
                  title="{{ if eq $index 0 }}Hide{{ else }}Show{{ end }} changes">{{ icon "chevron-right-lucide" 16 }}</button>
          {{ template "revision-item" $revision }}
          {{ if $root.CanEdit }}
            <form action="{{ route "/revisions/" }}{{ $revision.Number }}/restore/{{ $root.RevisionSlug }}"
                  method="post"
                  data-confirm="Restore revision {{ $revision.Number }}? Kumbuka will create a new revision. Metadata can only be restored when the historical revision has a metadata snapshot; review timestamps are not restored."
                  data-confirm-title="Restore revision"
                  data-confirm-label="Restore revision">
              <button class="button revision-restore-button" type="submit">
                {{ icon "history-lucide" 14 }}<span>Restore</span>
              </button>
            </form>
          {{ end }}
        </div>
        <div class="revision-entry-content"
             id="revision-content-{{ $revision.Number }}"
             data-revision-content
             {{ if ne $index 0 }}hidden{{ end }}>
          {{ if $revision.MetadataDiff }}
            <div class="revision-metadata-diff">
              <strong>Metadata changes</strong>
              <dl>
                {{ range $revision.MetadataDiff }}
                  <dt>{{ .Name }}</dt>
                  <dd>
                    <del>{{ .Before }}</del> <span aria-hidden="true">→</span> <ins>{{ .After }}</ins>
                  </dd>
                {{ end }}
              </dl>
            </div>
          {{ else if $revision.MetadataChanges }}
            <p class="revision-no-changes">Metadata changed: {{ range $index, $field := $revision.MetadataChanges }}{{ if $index }}, {{ end }}{{ $field }}{{ end }}. An earlier metadata snapshot is unavailable for comparison.</p>
          {{ end }}
          {{ if $revision.Diff }}
            <section class="revision-comparison"
                     aria-label="Markdown changes in revision {{ $revision.Number }}">
              <div class="revision-comparison-heading">
                <h3>Markdown changes</h3>
                <div class="revision-change-counts"
                     aria-label="{{ $revision.AddedLines }} added lines, {{ $revision.RemovedLines }} removed lines">
                  <span class="revision-count-added">+{{ $revision.AddedLines }} added</span>
                  <span class="revision-count-removed">−{{ $revision.RemovedLines }} removed</span>
                </div>
              </div>
              <p class="revision-diff-legend">Old and new line numbers · Green lines were added · Red lines were removed</p>
              <div class="revision-patch"
                   role="region"
                   tabindex="0"
                   aria-label="Line-by-line Markdown changes for revision {{ $revision.Number }}">
                {{ range $revision.Diff }}
                  {{ if ne .Kind "header" }}
                    <div class="revision-patch-line revision-patch-{{ .Kind }}">
                      <span class="revision-patch-line-number"
                            aria-label="Old line number">{{ if .OldLine }}{{ .OldLine }}{{ end }}</span>
                      <span class="revision-patch-line-number"
                            aria-label="New line number">{{ if .NewLine }}{{ .NewLine }}{{ end }}</span>
                      <span class="revision-patch-marker" aria-hidden="true">{{ .Marker }}</span>
                      <code>{{ .Text }}</code>
                    </div>
                  {{ end }}
                {{ end }}
              </div>
            </section>
          {{ else }}
            <p class="revision-no-changes">No Markdown changes.{{ if $revision.MetadataChanges }} Metadata changes are listed above.{{ end }}</p>
          {{ end }}
        </div>
      </article>
    {{ else }}
      <p class="muted">No revision history available.</p>
    {{ end }}
  </div>
{{ end }}
