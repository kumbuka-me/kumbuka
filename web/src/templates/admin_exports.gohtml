{{ define "content" }}
  <section class="admin-page">
    <div class="settings-heading">
      <p class="eyebrow">Administration</p>
      <h1>Exports</h1>
      <p class="muted">Export selected pages as a portable Kumbuka archive with metadata and referenced files.</p>
    </div>
    <section class="panel settings-panel">
      <p class="settings-note">
        Portable ZIP exports contain a versioned <code>manifest.json</code>, Markdown under <code>pages/</code>, page metadata under
        <code>metadata/</code>, referenced images under <code>media/</code>, and referenced files under <code>attachments/</code>.
        The archive can be imported into another Kumbuka instance.
      </p>
      <form action="/admin/export" method="post" data-export-form>
        <div class="export-actions">
          <button class="button primary" type="submit">Export selected</button>
          <button class="button" type="submit" name="all" value="true">Export all</button>
          <label>
            <input type="checkbox" data-export-all />
            Select all
          </label>
        </div>
        <div class="export-pages">
          {{ range .AdminPages }}
            <label>
              <input type="checkbox" name="slug" value="{{ .Slug }}" />
              <span><strong>{{ .Title }}</strong><small>{{ .Slug }}</small></span>
            </label>
          {{ else }}
            <p class="muted">No pages to export.</p>
          {{ end }}
        </div>
      </form>
    </section>
  </section>
{{ end }}
