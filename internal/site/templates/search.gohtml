{{ define "content" }}
  <section class="search-page static-search-page">
    <p class="eyebrow">Documentation search</p>
    <h1 data-static-search-title>All pages</h1>
    <p class="muted">Search runs entirely in your browser against the generated static index.</p>
    <div class="results static-search-results" data-static-search-results>
      <p class="muted">Loading search index…</p>
    </div>
  </section>
{{ end }}
