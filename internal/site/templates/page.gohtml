{{ define "content" }}
  <article class="page" data-page-layout>
    <div class="page-heading">
      <div>
        <p class="breadcrumbs">Documentation{{ if .CurrentRoute }} / {{ .CurrentRoute }}{{ end }}</p>
        <h1 class="page-title-with-icon" lang="{{ .Language }}">
          <span>{{ .Title }}</span>
        </h1>
      </div>
    </div>
    <div class="page-reading{{ if .PageContents }} with-contents{{ end }}">
      <div class="prose" lang="{{ .Language }}">{{ .HTML }}</div>
      {{ if .PageContents }}
        <aside class="page-contents"
               id="page-contents"
               data-page-contents
               aria-label="Page contents">
          <div class="page-contents-heading">
            <strong>Contents</strong>
            <button class="page-contents-close"
                    type="button"
                    data-page-contents-close
                    aria-label="Close page contents">{{ icon "x-lucide" 18 }}</button>
          </div>
          <nav>
            {{ range .PageContents }}
              <a class="contents-level-{{ .Level }}" href="#{{ .ID }}">{{ .Title }}</a>
            {{ end }}
          </nav>
        </aside>
      {{ end }}
    </div>
  </article>
  {{ if .PageContents }}
    <button class="contents-backdrop"
            type="button"
            data-page-contents-backdrop
            aria-label="Close page contents"
            hidden></button>
    <button class="contents-toggle"
            type="button"
            data-page-contents-toggle
            aria-controls="page-contents"
            aria-expanded="false"
            aria-pressed="true"
            aria-label="Hide page contents"
            title="Hide page contents">{{ icon "list-lucide" 17 }}</button>
  {{ end }}
{{ end }}
